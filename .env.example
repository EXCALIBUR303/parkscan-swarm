# Copy to .env and adjust. `make dev` reads this file.
# ---------------------------------------------------------------------------
# Database. Two supported layouts (see docs/adr/0003-postgis-image-and-port.md):
#   compose : PostGIS container on host port 5433 (5432 is owned by Homebrew PG17)
#   native  : brew-installed PostGIS on the running Homebrew PostgreSQL 17 (5432)
PARKSCAN_DB_MODE=compose
DATABASE_URL=postgresql+asyncpg://parkscan:parkscan@127.0.0.1:5433/parkscan
# native alternative:
# DATABASE_URL=postgresql+asyncpg://<your-macos-user>@127.0.0.1:5432/parkscan

# MQTT broker
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# API
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Run identity. Every telemetry/detection row is scoped to a run.
PARKSCAN_RUN_ID=dev
PARKSCAN_DATA_SOURCE=simulated
